# Copy to .env and fill in what you need. Every setting here is optional: API keys can also be
# entered in the web UI (Settings), where they are stored in the data volume (secrets.json, 0600).
# Environment variables always win over keys saved in the UI.

# Protect the web UI with HTTP Basic auth (any username, this password). Recommended if the
# port is reachable by anyone else on your network.
# CAREER_RADAR_PASSWORD=

# Accepted Host names besides IP addresses and localhost (comma-separated, "*" = any), e.g. a
# hostname you use on your network. Blocks DNS-rebinding attacks from web pages you visit.
# CAREER_RADAR_ALLOWED_HOSTS=radar.lan,radar.example.com

# Time zone for the schedule (collection/discovery times) and "new today" counts.
# CAREER_RADAR_TIMEZONE=America/Toronto

# --- LLM providers (optional; used for resume extraction and the board scout) ------------
# Pick the provider and model in Settings, or preselect them here. Provider ids:
#   openai | anthropic | openrouter | opencode-zen | opencode-go | codex | openai-compatible
# CAREER_RADAR_LLM_PROVIDER=openrouter
# CAREER_RADAR_LLM_MODEL=
# Only for openai-compatible, e.g. http://host.docker.internal:11434/v1 for Ollama on the host:
# CAREER_RADAR_LLM_BASE_URL=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_ZEN_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# ChatGPT (Codex) needs no key: use "Sign in with ChatGPT" in Settings.

# Disable the built-in scheduler (for example when you run `career-radar collect` from cron).
# CAREER_RADAR_SCHEDULER=0
